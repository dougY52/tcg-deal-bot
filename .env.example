# GitHub: Settings > Secrets and variables > Actions > New repository secret
# Name: DISCORD_WEBHOOK_URL
# Value: paste the real Discord URL ONLY into GitHub's secret field.
# Optional local use: export this environment variable in your own shell.
# The bot does not automatically read .env files.
DISCORD_WEBHOOK_URL=

# Optional free MediaMarkt/Saturn Worker, see cloudflare/mms-reader/README.md
# GitHub Cloud Watch uses short-lived OIDC automatically, no shared token needed.
TCG_CLOUD_READER_URL=
TCG_CLOUD_READER_TOKEN=

# Optional Pokemon Center access TEST, free ScrapingAnt account only.
# Not a working inventory scanner until a concrete DE product is validated.
# Used only in push/manual-dry-run diagnostics, never each five-minute scan.
SCRAPINGANT_API_KEY=
